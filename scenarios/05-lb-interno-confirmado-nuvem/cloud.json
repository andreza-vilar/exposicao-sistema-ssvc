{
  "LoadBalancers": [
    {
      "LoadBalancerName": "b",
      "DNSName": "b.elb.example.test",
      "Scheme": "internal",
      "SecurityGroups": [
        "sg-b"
      ]
    }
  ],
  "SecurityGroups": [
    {
      "GroupId": "sg-b",
      "IpPermissions": [
        {
