{
  "LoadBalancers": [
    {
      "LoadBalancerName": "synthetic-frontend",
      "DNSName": "synthetic.elb.example.test",
      "Scheme": "internet-facing",
      "SecurityGroups": ["sg-synthetic"]
    }
  ],
  "SecurityGroups": [
    {
      "GroupId": "sg-synthetic",
      "IpPermissions": [
        {
          "IpProtocol": "tcp",
          "FromPort": 80,
          "ToPort": 80,
          "IpRanges": [{"CidrIp": "0.0.0.0/0"}],
          "Ipv6Ranges": []
        }
      ]
    }
  ]
}
